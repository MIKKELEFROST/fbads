{
  "name": "website-promo-15s",
  "private": true,
  "description": "15-second motion graphic ad for a company that builds websites for service businesses",
  "type": "module",
  "scripts": {
    "audio": "python3 tools/make_audio.py",
    "render": "node tools/render.mjs",
    "render:portrait": "node tools/render.mjs --format=portrait",
    "posters": "node tools/render.mjs --poster && node tools/render.mjs --poster --format=portrait",
    "stills": "node tools/render.mjs --stills=0.3,1.2,2.4,3.2,4.0,6.6,9.9,13.8",
    "preview": "node tools/preview.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
